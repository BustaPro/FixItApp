<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F4F7"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:color/white"
        android:padding="20dp"
        android:elevation="4dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="24dp"
        android:layout_marginHorizontal="8dp"
        android:gravity="center_horizontal"
        android:clipToPadding="false">

        <!-- Título principal -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detalle del Servicio"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#0D47A1"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Nombre del cliente -->
        <TextView
            android:id="@+id/tvNombreClienteDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del cliente"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginBottom="12dp" />

        <!-- Tipo de servicio -->
        <TextView
            android:id="@+id/tvTipoServicioDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tipo de servicio"
            android:textSize="16sp"
            android:textColor="#424242"
            android:layout_marginBottom="8dp" />

        <!-- Fecha -->
        <TextView
            android:id="@+id/tvFechaDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fecha del servicio"
            android:textSize="16sp"
            android:textColor="#424242"
            android:layout_marginBottom="8dp" />

        <!-- Descripción -->
        <TextView
            android:id="@+id/tvDescripcionDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descripción del servicio"
            android:textSize="16sp"
            android:textColor="#555555"
            android:layout_marginBottom="8dp" />

        <!-- Estado -->
        <TextView
            android:id="@+id/tvEstadoDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estado: Pendiente"
            android:textSize="16sp"
            android:textStyle="italic"
            android:textColor="#777777"
            android:layout_marginBottom="20dp" />

        <!-- Botón Volver -->
        <Button
            android:id="@+id/btnVolver"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Volver"
            android:backgroundTint="#1565C0"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:padding="12dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/rounded_button" />

    </LinearLayout>
</ScrollView>
